/* css styles */

body {
  font-size: 1.05rem;
}

.navbar-brand {
  font-weight: 700;
}

h1 {
  margin-top: 1rem;
}

.hero {
  padding-top: 2rem;
  padding-bottom: 2rem;
}

.research-card {
  margin-bottom: 2rem;
}

img {
  border-radius: 6px;
}

:root {
  --forest: #184e3f;
  --sage: #52796f;
  --light-sage: #84a98c;
}

.navbar {
  background-color: #33404b;
}

.navbar a,
.navbar-brand {
  color: #ffffff !important;
}

a {
  color: #bcde72;
}

a:hover {
  color: #bcde72;
}

h1, h2, h3, h4 {
  color: #bcde72;
}

body {
  background-color: #435464;
  color: #c5c8c8;
}

